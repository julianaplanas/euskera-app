{
  "appId": "eus.euskarapraktika.app",
  "appName": "Euskara Praktika",
  "appendUserAgent": "EuskaraPraktikaApp",
  "webDir": "www",
  "server": {
    "url": "https://www.euskarapraktika.eus",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FFFFFF"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#FFFFFF"
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
